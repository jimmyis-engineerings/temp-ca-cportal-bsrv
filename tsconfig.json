{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "esModuleInterop": true,
    "strict": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "bun-types"],
    "baseUrl": ".", // This is important
    "paths": {
      "@/*": ["src/*"]
    },
  }
}